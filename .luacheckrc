-- Auto-generated from Umbrella (PZ LuaLS API stubs) top-level
-- global function/table declarations. Regenerate via extract_globals.sh
-- if Umbrella is updated for a new PZ build.
--
-- std = "lua51", NEVER "lua51+luajit": PZ runs Kahlua (a Lua 5.1
-- interpreter written in Java), not LuaJIT. Declaring luajit would let
-- luacheck pass code that uses LuaJIT-only stdlib and blows up at
-- runtime in-game.
std = "lua51"

-- PZ modding idiom is fundamentally built on monkey-patching/extending
-- vanilla classes (ISWearClothing.new, PZAPI.ModOptions.save, etc.) and
-- on defining new top-level globals (custom ISBaseTimedAction subclasses)
-- that get referenced from nested closures elsewhere in the same file.
-- allow_defined_top lets a global assigned at file scope be read from
-- nested functions without an extra "accessing undefined variable" warning.
allow_defined_top = true

-- std = "lua51" (PUC-Rio Lua 5.1) is a superset of what PZ actually runs.
-- Kahlua (PZ's own Lua 5.1 interpreter, written in Java) only implements a
-- subset of the stdlib: BaseLib, CoroutineLib, OsLib, RandomLib, StringLib,
-- TableLib (core/src/se/krka/kahlua/stdlib/). No IoLib, no PackageLib;
-- debug/xpcall/dofile/newproxy are not registered in BaseLib.java.
-- OsLib.java registers only os.date/os.difftime/os.time -- every other
-- os.* field would pass luacheck and then not exist at runtime in-game.
-- (Not removing next/loadstring/require/setfenv/getfenv: confirmed in real
-- use in the vanilla codebase despite being absent from Kahlua's public
-- repo -- the PZ fork diverged and added them.)
not_globals = {
    "io",
    "package",
    "debug",
    "xpcall",
    "dofile",
    "newproxy",
    "os.clock",
    "os.execute",
    "os.exit",
    "os.getenv",
    "os.remove",
    "os.rename",
    "os.setlocale",
    "os.tmpname",
}

-- 3317 globals extracted from Umbrella library/ stubs, plus
-- Kahlua's extra fields on the standard table/string/math libraries
-- (table.wipe, string.trim, math.clamp, ...) below.
--
-- Declared read-write (not read_globals): PZ mods routinely reopen/patch
-- vanilla classes (ISWearClothing, PZAPI.ModOptions, debugScenarios, ...),
-- which is normal here, not a bug -- read_globals would flag every one
-- of those legitimate patches as "setting read-only field/global".
